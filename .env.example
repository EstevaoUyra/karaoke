# Copy to .env and fill in what you have. Everything is optional.

# Lyrics: Genius API client access token (https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=

# Background pictures (`karaoke bg-search`; Wikimedia Commons needs no key)
# Pexels: https://www.pexels.com/api/ (200 requests an hour). Unsplash: https://unsplash.com/developers
# (the "Access Key"; 50 requests an hour for a demo app). Stock photographs: subjects and moods.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# An email or a URL of yours, sent to Wikimedia as part of the User-Agent. Their robot policy asks
# automated clients to say who runs them, and refuses many picture downloads from those that do not.
# KARAOKE_CONTACT=

# Overrides (defaults shown)
# KARAOKE_FFMPEG=/usr/local/opt/ffmpeg-full/bin/ffmpeg   # must have libass
# KARAOKE_WHISPER_MODEL=large-v3-turbo
# KARAOKE_SEPARATOR_MODEL=Kim_Vocal_2.onnx
# KARAOKE_DATA_DIR=./data
