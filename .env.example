# Copy to .env and fill in what you have. Everything is optional.

# Lyrics: Genius API client access token (https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=

# Background images (the backgrounds skill also uses Wikimedia Commons + web search without keys)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Overrides (defaults shown)
# KARAOKE_FFMPEG=/usr/local/opt/ffmpeg-full/bin/ffmpeg   # must have libass
# KARAOKE_WHISPER_MODEL=large-v3-turbo
# KARAOKE_SEPARATOR_MODEL=Kim_Vocal_2.onnx
# KARAOKE_DATA_DIR=./data
