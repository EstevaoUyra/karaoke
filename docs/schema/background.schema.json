{
  "$defs": {
    "BgSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "color",
            "gradient",
            "image",
            "video"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "credit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credit"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        }
      },
      "required": [
        "type"
      ],
      "title": "BgSource",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/BgSource"
        },
        "motion": {
          "default": "none",
          "enum": [
            "none",
            "kenburns-in",
            "kenburns-out",
            "pan-left",
            "pan-right"
          ],
          "title": "Motion",
          "type": "string"
        },
        "transition": {
          "$ref": "#/$defs/Transition"
        },
        "dim": {
          "default": 0.0,
          "title": "Dim",
          "type": "number"
        },
        "blur": {
          "default": 0.0,
          "title": "Blur",
          "type": "number"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "source"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "fade",
          "enum": [
            "cut",
            "fade"
          ],
          "title": "Type",
          "type": "string"
        },
        "duration": {
          "default": 1.0,
          "title": "Duration",
          "type": "number"
        }
      },
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "resolution": {
      "default": [
        1920,
        1080
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Resolution",
      "type": "array"
    },
    "fps": {
      "default": 30,
      "title": "Fps",
      "type": "integer"
    },
    "style": {
      "default": "default",
      "title": "Style",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "scenes"
  ],
  "title": "Background",
  "type": "object"
}
